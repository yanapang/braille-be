{
  "name": "braille-inspector-backend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch server/index.mjs",
    "dev:local": "NODE_ENV=development HOST=127.0.0.1 node --watch server/index.mjs",
    "docker:build": "docker build -t braille-backend:local .",
    "docker:run": "docker run --rm -p 8787:8787 braille-backend:local",
    "start:local": "NODE_ENV=production HOST=127.0.0.1 node server/index.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "liblouis": "^0.4.0",
    "liblouis-build": "3.2.0-rc",
    "morgan": "^1.11.0",
    "prom-client": "^15.1.3"
  }
}
